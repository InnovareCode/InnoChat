      "parameters": {
        "method": "GET",
        "url": "={{ $json.n8nApiUrl }}/executions/{{ $json.executionId }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
