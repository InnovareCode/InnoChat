    },
    {
      "id": "31f7dbc8-a538-478f-b341-80c8bd8d6544",
      "name": "Extrair trava",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "let exec = $input.first().json;\nlet data = exec.data;\nif (typeof data === 'string') { try { data = JSON.parse(data); } catch (e) { data = null; } }\nconst runData = (data && data.resultData && data.resultData.runData) || {};\nconst lastJson = (nodeName, pick) => {\n  const runs = runData[nodeName] || [];\n  for (let i = runs.length - 1; i >= 0; i--) {\n    const main = (runs[i] && runs[i].data && runs[i].data.main) || [];\n    for (const out of main) {\n      for (const it of (out || [])) {\n        if (it && it.json && pick(it.json)) return it.json;\n      }\n    }\n  }\n  return null;\n};\nconst claim = lastJson('Claim', (j) => j.action === 'process' && j.session && j.session.lockToken);\nconst cfg = lastJson('Config', (j) => !!j.token);\nif (!claim || !cfg) return [];\nreturn [{ json: { sessionId: claim.session.id, lockToken: claim.session.lockToken, token: cfg.token, painelUrl: cfg.painelUrl } }];"
      }
    },
    {
      "id": "32e12919-c48d-45e4-a475-d962d28ac980",
      "name": "Liberar trava",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1100,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $json.painelUrl }}/sessions/{{ encodeURIComponent($json.sessionId) }}/release",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {
              "name": "X-InnoChat-Instance",
              "value": "={{ $json.token }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ lockToken: $json.lockToken }) }}",
        "options": {
          "timeout": 10000
        }
      },
      "retryOnFail": true
    },
