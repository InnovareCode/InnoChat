// InnoChat — schema Fases 1, 2, 4 e 7 (docs/arquitetura.md).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Fase 1 — Identidade e plataforma
// ---------------------------------------------------------------------------

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String
  emailVerifiedAt   DateTime?
  isPlatformAdmin   Boolean   @default(false)
  termsAcceptedAt   DateTime?
  termsVersion      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  memberships       Membership[]
  authTokens        AuthToken[]
  platformSettingsUpdates PlatformSettings[] @relation("PlatformSettingsUpdatedBy")

  @@map("users")
}

enum AuthTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
  INVITE
}

model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_tokens")
}

// Instalação única do primeiro admin da plataforma (`/instalacao`, docs/contratos.md). Sem
// `userId`: nasce antes de existir qualquer `User` administrador. Regenerado a cada boot do
// servidor enquanto não houver admin (`src/instrumentation.ts`) — por isso não precisa de mais
// de uma linha vigente; a camada de aplicação apaga a anterior antes de criar a nova.
model PlatformInstallCode {
  id        String    @id @default(cuid())
  codeHash  String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("platform_install_codes")
}

enum PanelTheme {
  INDIGO_CLINICO
  AMBAR_ESTUDIO
  VERDE_SLATE
}

model Tenant {
  id        String     @id @default(cuid())
  slug      String     @unique
  name      String
  timezone  String
  // CPF/CNPJ da empresa (só dígitos), exigido pelo Mercado Pago para criar cobrança Pix
  // (`payer.identification` — ver `src/modules/billing/mercadopago.ts`). Decisão do dono,
  // 2026-09-29: como a PRIMEIRA fatura (com Pix) já nasce no cadastro, `signUpAction` passou a
  // EXIGIR este campo (`INVALID_DOCUMENT` se o dígito verificador for inválido) — toda empresa
  // criada a partir de então já nasce com `document` preenchido. Continua `String?` (nullable)
  // só por causa das empresas criadas ANTES desta mudança (nasceram com `null`) — para elas,
  // `updateTenantDocumentAction` (`src/modules/tenant/actions.ts`) continua existindo para
  // corrigir depois. Enquanto for `null`, a fatura nasce sem Pix (mesmo caminho já existente de
  // "Mercado Pago indisponível").
  document  String?
  segment   String?
  // Tema visual do painel (decisão do dono, 2026-09-28): só os 3 temas prontos abaixo — sem cor
  // personalizada, sem modo escuro e sem logo.
  theme     PanelTheme @default(INDIGO_CLINICO)

  // Regras de agenda/bot em colunas escalares (§5).
  slotGranularityMin        Int     @default(15)
  minLeadTimeMin            Int     @default(60)
  maxHorizonDays            Int     @default(30)
  cancelMinLeadMin          Int     @default(120)
  sessionTimeoutMin         Int     @default(30)
  humanPauseMin             Int     @default(720)
  askProfessional           Boolean @default(true)
  maxWhatsappNumbersOverride Int?
  maxProfessionalsOverride   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships        Membership[]
  services           Service[]
  professionals       Professional[]
  scheduleExceptions ScheduleException[]
  contacts           Contact[]
  appointments       Appointment[]
  whatsappInstances  WhatsappInstance[]
  botTexts           BotText[]
  subscription       Subscription?
  trialClaims        TrialClaim[]

  @@map("tenants")
}

enum MembershipRole {
  OWNER
  STAFF
}

model Membership {
  id        String         @id @default(cuid())
  userId    String
  tenantId  String
  role      MembershipRole
  createdAt DateTime       @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@map("memberships")
}

enum MercadoPagoEnvironment {
  PRODUCTION
  SANDBOX
}

// Singleton: sempre id = 1. A camada de aplicação faz upsert(where: { id: 1 }); nunca cria uma
// segunda linha. Não há constraint de banco reforçando "só 1 linha" — decisão consciente para não
// complicar a migração; se isso doer, trocar por CHECK (id = 1) é barato depois.
model PlatformSettings {
  id Int @id @default(1)

  // URL pública do painel (decisão do dono, 2026-09-28: nada de URL/credencial solta em env
  // var — só `DATABASE_URL`/`AUTH_SECRET` sobram no Easypanel). Normalmente derivada da própria
  // requisição (`src/lib/public-url.ts`, cabeçalhos `x-forwarded-host`/`x-forwarded-proto`);
  // este campo é só o OVERRIDE para contextos sem requisição (tick/cron) — preenchido sozinho
  // na 1ª vez que um admin salva Configurações, nunca editado à mão na v1.
  publicBaseUrl String?

  evolutionApiUrl String?
  evolutionApiKey String?

  n8nWebhookBaseUrl     String?
  internalApiSecretHash String?

  // Sincronização do n8n pelo painel (Fase 7+, docs/contratos.md "Configuração pela
  // plataforma"): API pública do n8n (`n8nBaseUrl` = ex. `https://n8n.exemplo.com`,
  // `n8nApiKey` mascarada na UI) e os IDs encontrados/criados na última sincronização — para a
  // sync ser idempotente (atualiza a mesma credencial/workflow, nunca duplica).
  n8nBaseUrl String?
  n8nApiKey  String?

  n8nCredPainelId    String?
  n8nCredEvolutionId String?
  n8nCredApiId       String?
  n8nWorkflowBotId    String?
  n8nWorkflowErrosId  String?
  // `innochat-cron` (Schedule de hora em hora → POST /billing/tick, ver src/modules/platform/
  // n8n-sync.ts) — opcional: pode não existir ainda no n8n do dono, `syncN8n` não falha por
  // isso, só avisa no resumo.
  n8nWorkflowCronId   String?

  // LEGADO (pré-2026-09-29): texto puro. Migração preguiçosa no código (`src/modules/platform/
  // mercadopago-config.ts`, `migrateLegacyPlatformSecrets`): na 1ª leitura/gravação o valor vai,
  // CIFRADO, para o par de PRODUÇÃO abaixo e estas duas colunas são zeradas. Não remover a
  // coluna ainda (migration destrutiva só depois de confirmado em produção).
  mercadoPagoAccessToken   String?
  mercadoPagoWebhookSecret String?

  // Mercado Pago no modelo do Parque das Feiras: par de PRODUÇÃO e par de TESTE (sandbox),
  // `mpEnvironment` escolhe o par ATIVO. Public Key não é segredo (claro); Access Token e
  // Webhook Secret são cifrados (`enc:v1:`, AES-256-GCM com chave derivada do AUTH_SECRET —
  // `src/lib/crypto.ts`). `mpEnabled=false` bloqueia só COBRANÇA NOVA (webhook segue valendo).
  mpEnvironment          MercadoPagoEnvironment @default(PRODUCTION)
  mpEnabled              Boolean                @default(true)
  mpProdPublicKey        String?
  mpProdAccessTokenEnc   String?
  mpProdWebhookSecretEnc String?
  mpTestPublicKey        String?
  mpTestAccessTokenEnc   String?
  mpTestWebhookSecretEnc String?

  // E-mail transacional via SMTP próprio (decisão do dono, 2026-09-28). emailProvider/emailApiKey
  // do desenho original da Nova (§1, §5) ficam de fora — não cabem no SMTP puro; se um provedor
  // de e-mail transacional (Resend etc.) entrar depois, é campo novo, não retrofit destes.
  smtpHost     String?
  smtpPort     Int?
  smtpSecure   Boolean?
  smtpUser     String?
  smtpPassword String?
  smtpFrom     String?

  // ÓRFÃO (decisão do dono, 2026-09-29): nenhum código lê/grava isto — o cadastro público confere
  // `TERMS_VERSION` (src/lib/legal.ts) direto, e nunca existiu tela de admin editando este campo.
  // Coluna mantida de propósito (nenhuma migration destrutiva sem necessidade real) — candidata
  // a uma migration de remoção quando convier ao Cronos.
  termsVersion String?

  // Dados jurídicos da empresa OPERADORA do InnoChat (Innovare Code) — decisão do dono,
  // 2026-09-29: nada disso pelo chat/código, tudo cadastrável pelo admin (tela "Dados
  // jurídicos"). Todos opcionais e NENHUM é segredo (podem voltar em claro pela action de
  // leitura) — são os mesmos dados que já apareceriam public/mente nos Termos/Privacidade.
  // `getPublicLegalInfo()` (src/modules/platform/legal-service.ts) expõe só estes campos para
  // as páginas `/termos` e `/privacidade` substituírem os marcadores `[CNPJ]`, `[ENDEREÇO]` etc.
  companyLegalName     String?
  companyCnpj          String?
  companyAddress       String?
  contactEmail         String?
  dpoName              String?
  dpoEmail             String?
  forumCity            String?
  hostingRegion        String?
  backupRetentionDays  Int?

  // Última execução dos jobs periódicos (`billing/tick`/`maintenance/tick`, chamados por cron
  // externo) — para a tela admin "Saúde" mostrar quando rodou e o resultado, e alertar se um tick
  // parou de rodar (docs/contratos.md, seção "Admin Saúde"). `*Result` guarda o resumo já
  // devolvido por cada tick (`BillingTickSummary`/`MaintenanceTickSummary`), sem achatar em
  // colunas novas a cada contador futuro.
  lastBillingTickAt        DateTime?
  lastBillingTickResult     Json?
  lastMaintenanceTickAt     DateTime?
  lastMaintenanceTickResult Json?

  updatedByUserId String?
  updatedAt       DateTime @updatedAt

  updatedBy User? @relation("PlatformSettingsUpdatedBy", fields: [updatedByUserId], references: [id])

  @@map("platform_settings")
}

// ---------------------------------------------------------------------------
// Fase 2 — Catálogo e agenda
// ---------------------------------------------------------------------------

model Service {
  id             String   @id @default(cuid())
  tenantId       String
  name           String
  durationMin    Int
  bufferAfterMin Int      @default(0)
  priceCents     Int?
  active         Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professionalServices  ProfessionalService[]
  appointments          Appointment[]

  @@index([tenantId, active, sortOrder])
  @@map("services")
}

model Professional {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant               Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workingHours         WorkingHour[]
  professionalServices ProfessionalService[]
  scheduleExceptions   ScheduleException[]
  appointments         Appointment[]

  @@index([tenantId, active, sortOrder])
  @@map("professionals")
}

model ProfessionalService {
  id             String @id @default(cuid())
  professionalId String
  serviceId      String

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([professionalId, serviceId])
  @@index([serviceId])
  @@map("professional_services")
}

// Hora local ("HH:mm") — o cálculo de slots converte para o fuso do Tenant (core/agenda).
model WorkingHour {
  id             String   @id @default(cuid())
  professionalId String
  weekday        Int // 0 (domingo) .. 6 (sábado)
  startTime      String // "HH:mm"
  endTime        String // "HH:mm"
  createdAt      DateTime @default(now())

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId, weekday])
  @@map("working_hours")
}

enum ScheduleExceptionType {
  BLOCK
  HOLIDAY
}

// professionalId nulo = escopo da empresa inteira.
model ScheduleException {
  id             String                 @id @default(cuid())
  tenantId       String
  professionalId String?
  type           ScheduleExceptionType
  startsAt       DateTime
  endsAt         DateTime
  reason         String?
  createdAt      DateTime               @default(now())

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professional Professional? @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([tenantId, startsAt])
  @@index([professionalId, startsAt])
  @@map("schedule_exceptions")
}

model Contact {
  id            String    @id @default(cuid())
  tenantId      String
  waJid         String
  phoneE164     String?
  lid           String?
  name          String?
  pushName      String?
  notes         String?
  botPausedUntil DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  chatSessions ChatSession[]

  @@unique([tenantId, waJid])
  @@index([tenantId])
  @@map("contacts")
}

enum AppointmentStatus {
  SCHEDULED
  CANCELED
  COMPLETED
  NO_SHOW
}

enum AppointmentSource {
  WHATSAPP
  PANEL
}

model Appointment {
  id                String            @id @default(cuid())
  tenantId          String
  contactId         String
  serviceId         String
  professionalId    String
  whatsappInstanceId String?
  // timestamptz explícito: o EXCLUDE usa tstzrange(startsAt, blockEndsAt) e essa função só é
  // IMMUTABLE (exigido em índice) sobre timestamptz — timestamp "naive" force um cast implícito
  // dependente do TimeZone da sessão, e a criação da constraint falha.
  startsAt          DateTime @db.Timestamptz
  endsAt            DateTime @db.Timestamptz
  // endsAt + Service.bufferAfterMin no momento da reserva — denormalizado de propósito: é o campo
  // usado no range do EXCLUDE (migration SQL manual, ver 0002_appointment_exclude_no_overlap).
  blockEndsAt       DateTime @db.Timestamptz
  status            AppointmentStatus @default(SCHEDULED)
  source            AppointmentSource @default(WHATSAPP)
  idempotencyKey    String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact          Contact           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  service          Service           @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  professional     Professional      @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  whatsappInstance WhatsappInstance? @relation(fields: [whatsappInstanceId], references: [id], onDelete: SetNull)
  events           AppointmentEvent[]

  // Índices para as consultas quentes (§5, §8):
  // - disponibilidade por profissional e dia
  // - agendamentos por tenant e período
  @@index([professionalId, startsAt])
  @@index([tenantId, startsAt])
  @@unique([tenantId, idempotencyKey])
  @@map("appointments")
}
// A constraint EXCLUDE USING gist (professionalId, tstzrange(startsAt, blockEndsAt, '[)')) WHERE
// status = 'SCHEDULED' está na migration SQL manual 0002_appointment_exclude_no_overlap (precisa
// de btree_gist; Prisma não expressa EXCLUDE no schema).

enum AppointmentEventAuthorType {
  CONTACT
  USER
  SYSTEM
}

enum AppointmentEventAction {
  CREATED
  CANCELED
  RESCHEDULED
  COMPLETED
  NO_SHOW
}

// Trilha imutável: só INSERT pela aplicação.
model AppointmentEvent {
  id            String                     @id @default(cuid())
  appointmentId String
  action        AppointmentEventAction
  authorType    AppointmentEventAuthorType
  authorId      String?
  note          String?
  createdAt     DateTime                   @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId, createdAt])
  @@map("appointment_events")
}

// ---------------------------------------------------------------------------
// Fase 4 — Bot (instâncias, sessão de conversa, dedupe, textos)
// ---------------------------------------------------------------------------

enum WhatsappInstanceStatus {
  QRCODE
  CONNECTED
  DISCONNECTED
}

model WhatsappInstance {
  id              String                  @id @default(cuid())
  tenantId        String
  instanceName    String                  @unique
  label           String
  status          WhatsappInstanceStatus  @default(QRCODE)
  phoneE164       String?
  webhookToken    String                  @unique
  // true = instância de teste (nó 11 do workflow desvia o envio para /sandbox/outbox em vez da
  // Evolution real). Usada pela bateria de roteiros (§8) e para validar edições do dono no n8n.
  sandbox         Boolean                 @default(false)
  lastConnectedAt DateTime?
  deletedAt       DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chatSessions ChatSession[]
  inboundEvents InboundEvent[]
  appointments Appointment[]

  @@index([tenantId])
  @@map("whatsapp_instances")
}

model ChatSession {
  id                 String   @id @default(cuid())
  whatsappInstanceId String
  contactId          String
  // Estado da máquina do menu (§3) — de propriedade do n8n, não validado por enum no banco:
  // o Switch do workflow decide os valores válidos, e travar isso aqui obrigaria uma migration
  // toda vez que o dono adicionar um passo no fluxo do n8n.
  state              String
  context            Json     @default("{}")
  invalidCount       Int      @default(0)
  version            Int      @default(0)
  lockToken          String?
  lockedUntil        DateTime?
  lastInboundAt      DateTime @default(now())
  humanUntil         DateTime?
  // Hashes + instante das últimas saídas (janela de ~2 min) para reconhecer o eco `fromMe` (§2.7).
  recentOutbound     Json     @default("[]")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  whatsappInstance WhatsappInstance @relation(fields: [whatsappInstanceId], references: [id], onDelete: Cascade)
  contact          Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)

  // Chave de acesso do endpoint /messages/claim: WHERE whatsappInstanceId = ? AND contactId = ?.
  @@unique([whatsappInstanceId, contactId])
  @@map("chat_sessions")
}

enum InboundOutcome {
  PROCESS
  BUSY
  IGNORE
}

enum InboundIgnoreReason {
  DUPLICATE
  STALE
  GROUP
  UNSUPPORTED_EVENT
  FROM_ME_ECHO
  HUMAN_TOOK_OVER
  HUMAN_MODE
  BOT_PAUSED
  TENANT_SUSPENDED
  UNRESOLVABLE_SENDER
}

// Dedupe + trilha de auditoria do webhook. Sem conteúdo de mensagem (LGPD, §11) — purga após 30
// dias (job fora do escopo deste schema; ver PENDÊNCIAS no handoff).
model InboundEvent {
  id                 String              @id @default(cuid())
  whatsappInstanceId String
  providerMessageId  String
  outcome            InboundOutcome
  reason             InboundIgnoreReason?
  stateBefore        String?
  stateAfter         String?
  createdAt          DateTime            @default(now())

  whatsappInstance WhatsappInstance @relation(fields: [whatsappInstanceId], references: [id], onDelete: Cascade)

  @@unique([whatsappInstanceId, providerMessageId])
  @@index([createdAt])
  @@map("inbound_events")
}

// Enum fechado (§6.7); os padrões de cada chave ficam no código do painel — só existe linha aqui
// quando o tenant edita o texto.
enum BotTextKey {
  GREETING
  MAIN_MENU
  CHOOSE_SERVICE
  CHOOSE_PROFESSIONAL
  CHOOSE_DAY
  CHOOSE_TIME
  NO_SLOTS_DAY
  NO_AVAILABILITY
  ASK_NAME
  CONFIRM_SUMMARY
  BOOKED
  SLOT_TAKEN
  MY_APPOINTMENTS
  NO_APPOINTMENTS
  APPOINTMENT_ACTIONS
  CONFIRM_CANCEL
  CANCELED
  RESCHEDULED
  TOO_LATE
  HUMAN_HANDOFF
  INVALID_OPTION
  TOO_MANY_INVALID
  ONLY_TEXT
  SESSION_EXPIRED
  GOODBYE
  LABEL_CONFIRM
  LABEL_OTHER_TIME
  LABEL_CANCEL_YES
  LABEL_CANCEL_NO
  LABEL_MORE_DAYS
  LABEL_MORE_TIMES
  LABEL_MORE
  LABEL_BACK_TO_MENU
}

model BotText {
  id        String     @id @default(cuid())
  tenantId  String
  key       BotTextKey
  text      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@map("bot_texts")
}

// ---------------------------------------------------------------------------
// Fase 7 — Cadastro público, planos e cobrança (§7, §15)
// ---------------------------------------------------------------------------

// Catálogo de planos, editado pelo admin da plataforma (tela "Planos", §9). Global, não
// tenant-scoped.
//
// Preço (decisão do dono, 2026-09-28): ainda não definido. Em vez de gravar um valor "provisório"
// que alguém pode esquecer de trocar antes do lançamento, o seed cria os 3 planos com
// `priceCents = 0` e `active = false` — mais seguro que um preço chutado: com `active = false`
// eles não aparecem no cadastro público nem podem ser escolhidos, então é estruturalmente
// impossível vender por engano a um preço errado. O admin edita o preço e ativa quando o dono
// decidir (tela "Planos", §9). Ver PENDÊNCIAS no handoff.
model Plan {
  id   String @id @default(cuid())
  code String @unique
  name String

  priceCents Int

  maxWhatsappNumbers Int
  // null = ilimitado (plano Clínica, §7.2). maxWhatsappNumbers nunca é ilimitado nos 3 planos
  // aprovados, por isso não é nullable — só maxProfessionals precisa do null.
  maxProfessionals   Int?

  active    Boolean @default(false)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions        Subscription[] @relation("SubscriptionPlan")
  pendingSubscriptions Subscription[] @relation("SubscriptionPendingPlan")

  @@map("plans")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELED
}

// Uma assinatura por tenant (§5: "Subscription (1 por tenant)") — `tenantId` é @unique, não só
// indexado, e é isso que a constraint de banco reforça: nunca existem duas linhas de Subscription
// para o mesmo tenant, nem uma "segunda assinatura ativa" nem histórico de assinaturas antigas.
// Trocar de plano reescreve esta mesma linha (`planId`/`pendingPlanId`); cancelar e reativar
// também (`status` volta a ACTIVE, §7.4). Se algum dia precisar de histórico de assinaturas
// (ex.: auditoria de troca de plano), isso é tabela nova, não a remoção deste unique.
//
// Overrides de limite (`maxWhatsappNumbersOverride`/`maxProfessionalsOverride`) já existem em
// `Tenant` desde a Fase 1 (§5) — decisão: não duplicar aqui. Um valor só, sem duas fontes que
// podem divergir sobre "qual limite vale". Ver PARA O PRÓXIMO no handoff.
model Subscription {
  id       String @id @default(cuid())
  tenantId String @unique

  planId        String
  pendingPlanId String?
  status        SubscriptionStatus @default(TRIALING)

  // Trial de 1 dia (decisão do dono, 2026-09-28): preenchido no cadastro como `createdAt + 24h`.
  // Nulo depois que a assinatura sai de TRIALING (não volta a preencher em downgrade/reativação).
  trialEndsAt DateTime?
  // Fim do período pago corrente. No cadastro, já nasce igual a `trialEndsAt` (o trial É o
  // primeiro período, e a primeira fatura — §7.3 — cobre esse mesmo ciclo). Avança em +1 mês a
  // cada pagamento confirmado (§7.1), mantendo o dia-âncora.
  currentPeriodEnd DateTime

  canceledAt DateTime?

  // Marca de e-mail já enviado (Vega, Fase 7 — billing/tick): sem isto, rodar o tick de hora em
  // hora reenviaria o aviso de "atendimento suspenso" a cada rodada enquanto o tenant continuar
  // SUSPENDED. Nulo = ainda não avisado NESTA suspensão; volta a nulo quando a assinatura sai de
  // SUSPENDED (reativação/pagamento), para avisar de novo numa suspensão futura.
  suspendedEmailSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan        Plan      @relation("SubscriptionPlan", fields: [planId], references: [id])
  pendingPlan Plan?     @relation("SubscriptionPendingPlan", fields: [pendingPlanId], references: [id])
  invoices    Invoice[]

  // billing/tick (§6.8) roda a cada hora e precisa achar, sem varrer a tabela inteira:
  // - quem está perto de vencer (gerar fatura 5 dias antes / expirar trial) → (status, currentPeriodEnd)
  // - quem ainda está no trial de 1 dia, para fechar TRIALING → PAST_DUE → (status, trialEndsAt)
  @@index([status, currentPeriodEnd])
  @@index([status, trialEndsAt])
  @@map("subscriptions")
}

enum InvoiceStatus {
  OPEN
  PAID
  EXPIRED
  VOID
}

// Pendurada em Subscription, não em Tenant direto (§5, diagrama) — segue o padrão já usado em
// AppointmentEvent/ChatSession/InboundEvent (models tenant-scoped SEM coluna tenantId própria,
// isolados por relação até o pai que tem `tenantId`). Ver PARA O PRÓXIMO no handoff: Invoice NÃO
// entra em TENANT_SCOPED_MODELS por não ter `tenantId` próprio — quem ler Invoice precisa
// carregar a Subscription (já escopada por tenant) primeiro.
model Invoice {
  id             String @id @default(cuid())
  subscriptionId String

  amountCents Int
  periodStart DateTime
  periodEnd   DateTime
  dueAt       DateTime

  status InvoiceStatus @default(OPEN)

  // Pix (Mercado Pago, §7.1). `pixExpiresAt` = geração + 3 dias; se expirar, o `billing/tick`
  // marca EXPIRED (não paga) e o Pix é regerado sob demanda pela tela de Assinatura, na MESMA
  // fatura (não cria outra linha — só reescreve mpPaymentId/pixQrCode/pixCopyPaste/pixExpiresAt).
  mpPaymentId  String?
  pixQrCode    String?
  pixCopyPaste String?
  pixExpiresAt DateTime?
  paidAt       DateTime?

  // Marcas de e-mail já enviado (Vega, Fase 7 — billing/tick, §7.1 "aviso... 1 dia antes do
  // vencimento e no vencimento"): sem isto, um tick de hora em hora reenviaria o mesmo lembrete
  // várias vezes no mesmo dia. Nulo = ainda não enviado; nunca voltam a nulo (é por fatura, e
  // cada fatura só tem 1 vencimento).
  dueReminderEmailSentAt DateTime?
  dueTodayEmailSentAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  // Uma fatura por ciclo de cobrança (§5): impede o billing/tick gerar duas faturas para o mesmo
  // período se rodar em cima da hora (idempotência "por desenho", não só pelo `{ invoicesCreated }`
  // da resposta).
  @@unique([subscriptionId, periodStart])
  // billing/tick: faturas OPEN vencendo (lembrete + baixa de PAST_DUE) e Pix OPEN a expirar.
  @@index([status, dueAt])
  @@index([status, pixExpiresAt])
  // Webhook do Mercado Pago (§6.10): acha a fatura pelo id do pagamento antes de reconsultar a API.
  @@index([mpPaymentId])
  @@map("invoices")
}

// Idempotência do webhook do Mercado Pago (§6.10, §11): `provider` + `providerEventId` são a
// dedupe de verdade — o mesmo evento reentregue (retry do MP) não reprocessa. `payload` guarda o
// corpo bruto para auditoria; `processedAt` nulo = recebido mas ainda não aplicado (o handler
// sempre reconsulta `GET /v1/payments/{id}` antes de dar baixa, nunca confia neste payload).
// Global (não tenant-scoped): o evento chega sem tenant resolvido até o handler achar a fatura
// pelo `mpPaymentId`.
model ProviderEvent {
  id              String @id @default(cuid())
  provider        String
  providerEventId String

  payload     Json
  processedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([provider, providerEventId])
  @@map("provider_events")
}

// Anti-abuso de trial em série (§7.3 regra 4): um número de WhatsApp só entra em trial uma vez,
// em qualquer empresa. Por isso `phoneE164` é @unique sozinho (não composto com tenantId) — a
// verificação precisa ser CROSS-tenant por desenho, o oposto de todo o resto do isolamento por
// tenant do sistema. `tenantId` aqui é só "qual empresa consumiu o trial deste número", para a
// mensagem de erro/auditoria — nunca use este campo para escopo de leitura.
// NÃO entra em TENANT_SCOPED_MODELS mesmo tendo `tenantId` próprio (ver PARA O PRÓXIMO no
// handoff): `forTenant()` filtraria por tenant e quebraria exatamente a checagem cross-tenant que
// este model existe para fazer.
model TrialClaim {
  id          String  @id @default(cuid())
  phoneE164   String  @unique
  emailDomain String?
  tenantId    String

  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("trial_claims")
}
